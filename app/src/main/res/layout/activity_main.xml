<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Recursos Digitales "
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#3A1F12"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Panel principal —"
            android:textSize="18sp"
            android:textColor="#8A6547"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp" />

        <!-- FILA 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/cardVerRecursos"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginEnd="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_ver_recursos"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver recursos"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAgregarRecurso"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginStart="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_agregar_recursos"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agregar recurso"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- FILA 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/cardBuscarRecurso"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginEnd="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_buscar"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEditarEliminar"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginStart="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_editar_eliminar"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Editar / Eliminar"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- FILA 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/cardReportes"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginEnd="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_reportes"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reportes"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardCerrarSesion"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:padding="12dp"
                android:layout_marginStart="9dp">

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/btn_cerrar_sesion"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cerrar sesión"
                    android:textColor="#3A1F12"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>