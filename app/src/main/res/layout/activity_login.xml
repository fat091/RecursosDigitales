<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Recursos Digitales "
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#3A1F12"
            android:gravity="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Accede a tu panel de recursos —"
            android:textSize="16sp"
            android:textColor="#8A6547"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:src="@drawable/btn_reportes"
            android:scaleType="centerInside"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <EditText
                android:id="@+id/edtCorreo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Correo"
                android:textColor="#3A1F12"
                android:textColorHint="#A98970"
                android:background="@drawable/bg_input"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Contraseña"
                android:textColor="#3A1F12"
                android:textColorHint="#A98970"
                android:background="@drawable/bg_input"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Iniciar sesión"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_brown" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectado con PHP, MySQL y JSON"
            android:textColor="#6F4C36"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="22dp" />

    </LinearLayout>

</ScrollView>