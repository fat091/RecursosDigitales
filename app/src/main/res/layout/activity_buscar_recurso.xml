<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutPrincipalBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- REGRESAR -->
        <TextView
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="34sp"
            android:textColor="#3A1F12"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Buscar Recursos "
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#3A1F12"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Encuentra recursos por nombre, categoría o nivel —"
            android:textSize="15sp"
            android:textColor="#8A6547"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- TARJETA DE BÚSQUEDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <EditText
                android:id="@+id/edtBusqueda"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Buscar recurso..."
                android:textColor="#3A1F12"
                android:textColorHint="#A98970"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Buscar"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_brown" />

        </LinearLayout>

        <!-- RESULTADOS -->
        <TextView
            android:id="@+id/txtTituloResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultados encontrados"
            android:textColor="#3A1F12"
            android:textStyle="bold"
            android:textSize="21sp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:id="@+id/contenedorResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>